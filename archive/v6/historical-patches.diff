+// 镜像核心 dist/tokens-BTKQYTUd.mjs 的 isSilentReplyText / isSilentReplyPrefixText 语义：
+// message 工具发出 NO_REPLY / HEARTBEAT_OK 等静默 token 时，跳过真实 QQ API 发送，
+// 直接返回成功结果，避免 message_tool_only 模式下 runtime 判定“没有可见交付”而死循环。
+var QQ_SILENT_REPLY_TOKENS = ["NO_REPLY", "HEARTBEAT_OK"];
+function isQQBotSilentReply(text) {
+  if (!text || typeof text !== "string") return false;
+  const trimmed = text.trim();
+  if (!trimmed) return false;
+  const stripEdgePunctuation = (s) => s.replace(/^\p{P}+/u, "").replace(/\p{P}+$/u, "");
+  // 完全等于：带可选空白/可重复/边缘标点，大小写不敏感（与核心 getSilentExactRegex 一致）
+  const exactRe = /^\s*(?:NO_REPLY|HEARTBEAT_OK)(?:\s+(?:NO_REPLY|HEARTBEAT_OK))*\s*$/i;
+  if (exactRe.test(trimmed) || exactRe.test(stripEdgePunctuation(trimmed))) return true;
+  // 前缀匹配：全大写、长度>=2、是某个静默 token 的前缀（与核心 isSilentReplyPrefixText 一致）
+  if (trimmed === trimmed.toUpperCase() && trimmed.length >= 2) {
+    for (const token of QQ_SILENT_REPLY_TOKENS) {
+      if (token.length > trimmed.length && token.startsWith(trimmed)) return true;
+    }
+  }
+  return false;
